{
  "manifest_version": 3,
  "name": "CodeSpeakForYoutube",
  "version": "0.1.0",
  "description": "Make English YouTube subtitles clickable and save useful words locally.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://codespeakforyoutube.1242196553.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "CodeSpeakForYoutube",
    "default_popup": "dist/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_idle"
    }
  ]
}
